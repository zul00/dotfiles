#!/bin/sh

case $BLOCK_BUTTON in
	1) pavucontrol & ;;
	2) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
	4) pactl set-sink-volume @DEFAULT_SINK@ +5% ;;
	5) pactl set-sink-volume @DEFAULT_SINK@ -5% ;;
	3) notify-send "Audio devices" "$(printf 'O: %s\nI: %s' "$(~/bin/which_audio_sink.sh)" "$(~/bin/which_audio_source.sh)")" ;;
esac

# [ "$(pactl get-sink-mute @DEFAULT_SINK@)" = "Mute: yes" ] && printf "🔇\\n" && exit

vol=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}')
vol_num=${vol%\%}

if [ "$(pactl get-sink-mute @DEFAULT_SINK@)" = "Mute: yes" ]; then
    icon=""
elif [ "$vol_num" -gt "70" ]; then
	icon=""
elif [ "$vol_num" -lt "30" ]; then
	icon=""
else
	icon=""
fi

if [ "$(pactl get-source-mute @DEFAULT_SOURCE@)" = "Mute: yes" ]; then
    micicon=""
else
    micicon=""
fi

profile_marker=
sink=$(pactl get-default-sink)
case $sink in
    bluez_output.*|bluez_sink.*)
        device=${sink#*.}
        card=bluez_card.${device%%.*}
        profile=$(pactl list cards | awk -v card="$card" '
            $1 == "Name:" { found = ($2 == card) }
            found && $1 == "Active" && $2 == "Profile:" { print $3; exit }
        ')
        case $profile in
            a2dp*) profile_marker=A ;;
            headset-head-unit*|headset_head_unit*|handsfree-head-unit*|handsfree_head_unit*) profile_marker=H ;;
        esac
        ;;
esac

printf "%s%s %s %s\\n" "$icon" "$profile_marker" "$vol" "$micicon"
