#!/usr/bin/env bash

set -euo pipefail

die() {
  echo "Error: $*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"
}

usage() {
  echo "Usage: $(basename "$0") <csv_file>" >&2
  exit 1
}

for cmd in awk bw findmnt fzf jq mktemp mount.cifs smbclient sort sudo; do
  require_cmd "$cmd"
done

[[ $# -eq 1 ]] || usage

CSV_FILE="$1"

[[ -r "$CSV_FILE" ]] || die "CSV file not found: $CSV_FILE"

server_rows="$(
  awk -F',' '
    NR == 1 && $1 == "name" { next }
    NF >= 4 {
      for (i = 1; i <= 4; i++) gsub(/^[[:space:]]+|[[:space:]]+$/, "", $i)
      if ($1 == "" || $1 ~ /^#/) next
      printf "%s\t%s\t%s\t%s\n", $1, $2, $3, $4
    }
  ' "$CSV_FILE"
)"

[[ -n "$server_rows" ]] || die "No valid server entries in $CSV_FILE"

# Choose SMB server
selected="$(
  printf '%s\n' "$server_rows" \
    | fzf \
      --delimiter=$'\t' \
      --with-nth=1,3 \
      --header="Select SMB server"
)" || true

[[ -z "$selected" ]] && exit 0

IFS=$'\t' read -r server_name mount_root server_host bw_item_id <<< "$selected"
server_host="${server_host#smb://}"
server_host="${server_host%%/*}"
[[ -n "$server_host" ]] || die "Invalid host for $server_name"

# Query server shares
bw_session="$(bw unlock --raw)"
item_json="$(BW_SESSION="$bw_session" bw get item "$bw_item_id" 2>/dev/null || true)"
bw_user="$(printf '%s' "$item_json" | jq -r '.login.username // empty')"
bw_pass="$(printf '%s' "$item_json" | jq -r '.login.password // empty')"
[[ -n "$item_json" ]] || die "Bitwarden item not found for item: $bw_item_id"
[[ -n "$bw_user" ]] || die "Bitwarden username not found for item: $bw_item_id"
[[ -n "$bw_pass" ]] || die "Bitwarden password not found for item: $bw_item_id"

auth_file="$(mktemp)"
trap 'rm -f "$auth_file"' EXIT
chmod 600 "$auth_file"
cat > "$auth_file" <<EOF
username=$bw_user
password=$bw_pass
EOF

dir_rows="$(
  smbclient -g -L "$server_host" -A "$auth_file" \
    | awk -F'|' '
      ($2 == "Disk" && $1 != "IPC$") { print $1 }
      ($1 == "Disk" && $2 != "IPC$") { print $2 }
    ' \
    | awk 'NF' \
    | sort -u
)"

[[ -n "$dir_rows" ]] || die "No SMB shares found on $server_host"

selected_share="$(
  printf '%s\n' "$dir_rows" \
    | fzf \
      --header="Select SMB share"
)" || true

[[ -z "$selected_share" ]] && exit 0

mount_path="/mnt/$mount_root/$selected_share"

if findmnt -rn --mountpoint "$mount_path" >/dev/null 2>&1; then
  echo "Already mounted: $mount_path"
  exit 0
fi

sudo mkdir -p "$mount_path"
sudo mount.cifs "//$server_host/$selected_share" "$mount_path" \
  -o "credentials=$auth_file,uid=$(id -u),gid=$(id -g)"

echo "Mounted //$server_host/$selected_share to $mount_path"
